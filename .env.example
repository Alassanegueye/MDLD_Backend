# ============================================================
# Backend MDLD — variables d'environnement
# Copier ce fichier en .env puis renseigner chaque clé.
# L'application REFUSE de démarrer si une clé critique manque,
# si deux secrets JWT sont identiques, ou si une valeur
# d'exemple traîne encore en production (cf. config/security.js).
# ============================================================

# ---- Serveur ----
NODE_ENV=development
PORT=4000
API_PREFIX=/mdld/v1

# ---- Base de données PostgreSQL ----
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mdld
DB_USER=mdld
DB_PASSWORD=change-moi
# Taille du pool : à ajuster selon le nombre de workers
DB_POOL_MAX=10
DB_POOL_MIN=0
DB_POOL_IDLE=10000
DB_POOL_ACQUIRE=30000
# true uniquement chez un hébergeur qui impose TLS (Render, Neon…)
DB_SSL=false

# ---- Secrets JWT — TROIS secrets DISTINCTS, 32 caractères minimum ----
# Générer : node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=remplacer-par-un-secret-aleatoire-de-48-octets
JWT_REFRESH_SECRET=remplacer-par-un-autre-secret-aleatoire-distinct
JWT_RESET_SECRET=remplacer-par-un-troisieme-secret-encore-different
JWT_ACCESS_EXPIRES=1h
JWT_REFRESH_EXPIRES=7d
JWT_RESET_EXPIRES=1h
# Nombre de sessions simultanées par compte (les plus anciennes sont révoquées)
MAX_REFRESH_TOKENS=5

# ---- Mots de passe ----
BCRYPT_ROUNDS=12

# ---- CORS : liste blanche, séparée par des virgules. « * » est refusé en production ----
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# ---- Journalisation ----
LOG_LEVEL=info
LOG_DIR=logs

# ---- Compte administrateur initial (utilisé par le seeder) ----
ADMIN_EMAIL=admin@mosqueedeladivinite.org
ADMIN_PASSWORD=change-moi-immediatement
ADMIN_NOM=Administrateur
ADMIN_PRENOM=MDLD
